# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Both values come from the cloud side (docs/azure-setup.md §3). Ask Protsahan
# for the key — he generates it and sends it privately, not in a group chat.

# Base URL of the Function App, no trailing slash and no /api suffix.
API_URL=https://func-baettledger.azurewebsites.net

# Shared secret sent as the x-device-key header on every request.
DEVICE_KEY=replace-me
